# Qwen3-TTS Test Container
# Multi-stage build for efficient cross-platform testing
# Build with: docker build -f Dockerfile.test -t qwen3-tts:test .

FROM python:3.11-slim-bookworm AS test-base

# Install system dependencies for testing
# rubberband-cli is the BINARY pyrubberband shells out to. Without it the
# clone rate-control path degrades to unstretched audio and its tests fail --
# the Python package alone is not enough. The Colab notebook apt-installs it
# for the same reason.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    portaudio19-dev \
    rubberband-cli \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Test stage - installs test extras only
FROM test-base AS test
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Disable gradio telemetry in containers
    GRADIO_ANALYTICS_ENABLED=False

# Create non-root user for security with proper home directory
RUN useradd -m -u 1000 -s /bin/bash testuser && \
    mkdir -p /app /home/testuser/Qwen3-TTS_UserFiles /app/voice_prompts && \
    chown -R testuser:testuser /app /home/testuser

# Set environment for testuser
ENV USER_FILES_DIR=/home/testuser/Qwen3-TTS_UserFiles

# Copy package definition first for better layer caching
COPY --chown=testuser:testuser pyproject.toml README.md ./

# Install as testuser to avoid root pip installations
USER testuser
# dev  -> ruff/mypy/bandit. Without it the compose `gates` service silently
#         finds no `ruff` binary and (without `set -e`) reports success anyway.
# audio -> librosa. ensure_min_sample_rate() resamples through it, so without
#         this extra every reference-audio rate test fails in the container
#         while passing on the host — and the Linux half of that guarantee
#         goes unverified, which is the entire point of this image.
RUN pip install --user --upgrade pip && \
    pip install --user -e ".[test,dev,audio]"

# Switch back to root to copy files with proper permissions
USER root

# Copy source code and tests
COPY --chown=testuser:testuser qwen3_tts/ ./qwen3_tts/
COPY --chown=testuser:testuser tests/ ./tests/
COPY --chown=testuser:testuser config.json pytest.ini ./

# Repo-root files referenced by guard/drift tests (CLAUDE.md size guard,
# ARCHITECTURE.md companion, colab notebook drift, docker config drift,
# install.sh config-template drift) and by the static gates (.ruff.toml --
# without it ruff runs on its DEFAULT ruleset and reports hundreds of
# phantom errors that do not reproduce on the host).
COPY --chown=testuser:testuser CLAUDE.md colab_notebook.ipynb docker-compose.yml Dockerfile.vllm install.sh .ruff.toml Dockerfile.test docker-compose.test.yml ./
COPY --chown=testuser:testuser docs/ ./docs/
# test_workflow_timeouts.py reads these. Without them the gate cannot run in
# the container at all, and skipping it there would leave the batch reporting
# green while verifying nothing.
COPY --chown=testuser:testuser .github/workflows/ ./.github/workflows/
# tests/test_claude_hooks.py executes the PreToolUse hook scripts and reads
# the hooks-only shared settings. .dockerignore excludes .claude/ wholesale
# (local settings must never bake into an image); these two tracked,
# secret-free files are re-included there and copied explicitly, mirroring
# the .github/workflows pattern above.
COPY --chown=testuser:testuser .claude/hooks/ ./.claude/hooks/
COPY --chown=testuser:testuser .claude/settings.json ./.claude/settings.json

# Create expected directory structure with symlinks for both root and testuser
RUN mkdir -p /root/Qwen3-TTS_UserFiles /home/testuser/Qwen3-TTS_UserFiles && \
    ln -sf /app/config.json /root/Qwen3-TTS_UserFiles/config.json && \
    ln -sf /app/config.json /home/testuser/Qwen3-TTS_UserFiles/config.json && \
    ln -sf /app/voice_prompts /root/Qwen3-TTS_UserFiles/voice_prompts && \
    ln -sf /app/voice_prompts /home/testuser/Qwen3-TTS_UserFiles/voice_prompts && \
    chown -R testuser:testuser /home/testuser/Qwen3-TTS_UserFiles

# Run tests as non-root user
USER testuser
WORKDIR /app

# Health check for container readiness
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import pytest; import gradio; import qwen3_tts" || exit 1

# Run tests by default (can be overridden)
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]

# Qwen3-TTS Test Container
# Multi-stage build for efficient cross-platform testing
# Build with: docker build -f Dockerfile.test -t qwen3-tts:test .

FROM python:3.11-slim-bookworm AS test-base

# Install system dependencies for testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    portaudio19-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Test stage - installs test extras only
FROM test-base AS test
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Disable gradio telemetry in containers
    GRADIO_ANALYTICS_ENABLED=False

# Create non-root user for security with proper home directory
RUN useradd -m -u 1000 -s /bin/bash testuser && \
    mkdir -p /app /home/testuser/Qwen3-TTS_UserFiles /app/voice_prompts && \
    chown -R testuser:testuser /app /home/testuser

# Set environment for testuser
ENV USER_FILES_DIR=/home/testuser/Qwen3-TTS_UserFiles

# Copy package definition first for better layer caching
COPY --chown=testuser:testuser pyproject.toml README.md ./

# Install as testuser to avoid root pip installations
USER testuser
RUN pip install --user --upgrade pip && \
    pip install --user -e ".[test]"

# Switch back to root to copy files with proper permissions
USER root

# Copy source code and tests
COPY --chown=testuser:testuser qwen3_tts/ ./qwen3_tts/
COPY --chown=testuser:testuser tests/ ./tests/
COPY --chown=testuser:testuser config.json ./

# Repo-root files referenced by guard/drift tests (CLAUDE.md size guard,
# ARCHITECTURE.md companion, colab notebook drift, docker config drift)
COPY --chown=testuser:testuser CLAUDE.md colab_notebook.ipynb docker-compose.yml Dockerfile.vllm ./
COPY --chown=testuser:testuser docs/ ./docs/

# Create expected directory structure with symlinks for both root and testuser
RUN mkdir -p /root/Qwen3-TTS_UserFiles /home/testuser/Qwen3-TTS_UserFiles && \
    ln -sf /app/config.json /root/Qwen3-TTS_UserFiles/config.json && \
    ln -sf /app/config.json /home/testuser/Qwen3-TTS_UserFiles/config.json && \
    ln -sf /app/voice_prompts /root/Qwen3-TTS_UserFiles/voice_prompts && \
    ln -sf /app/voice_prompts /home/testuser/Qwen3-TTS_UserFiles/voice_prompts && \
    chown -R testuser:testuser /home/testuser/Qwen3-TTS_UserFiles

# Run tests as non-root user
USER testuser
WORKDIR /app

# Health check for container readiness
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import pytest; import gradio; import qwen3_tts" || exit 1

# Run tests by default (can be overridden)
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]

#!/bin/bash
# Launch the Qwen3-TTS web interface
# Reads backend from config.json and activates the correct conda environment

CONFIG_FILE="$HOME/Qwen3-TTS_UserFiles/config.json"

# Find and activate conda environment
if [[ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Read backend from config.json
BACKEND="torch"
if [ -f "$CONFIG_FILE" ]; then
    BACKEND=$(CONFIG_FILE="$CONFIG_FILE" python3 -c "
import json, os, sys
try:
    c = json.load(open(os.environ['CONFIG_FILE']))
    print(c.get('advanced', {}).get('backend', 'torch'))
except: print('torch')
" 2>/dev/null)
fi

# Select conda environment based on backend
if [ "$BACKEND" = "mlx" ]; then
    CONDA_ENV="qwen3-tts-mlx"

    # Verify the MLX environment exists
    if ! conda env list 2>/dev/null | grep -q "^${CONDA_ENV} "; then
        echo ""
        echo "Error: MLX backend selected but environment '$CONDA_ENV' not found."
        echo "Please run './install.sh' from ~/Qwen3-TTS_UserFiles to set it up,"
        echo "or switch to the torch backend in config.json:"
        echo '  "advanced": { "backend": "torch" }'
        exit 1
    fi
else
    CONDA_ENV="qwen3-tts"
fi

# Deactivate any current env, then activate the correct one
conda deactivate 2>/dev/null
conda activate "$CONDA_ENV"

python ~/Qwen3-TTS_UserFiles/voice_ui.py "$@"

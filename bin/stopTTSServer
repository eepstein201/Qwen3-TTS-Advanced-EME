#!/bin/bash
# Stop the TTS server

PID_FILE="$HOME/Qwen3-TTS_UserFiles/.voice_server.pid"
TOKEN_FILE="$HOME/.voice_server_token"

# Try graceful shutdown via API first (with auth token if available)
if [ -f "$TOKEN_FILE" ]; then
    TOKEN=$(cat "$TOKEN_FILE")
    curl -s -X POST -H "Authorization: Bearer $TOKEN" http://127.0.0.1:5123/shutdown > /dev/null 2>&1
else
    curl -s -X POST http://127.0.0.1:5123/shutdown > /dev/null 2>&1
fi

if [ $? -eq 0 ]; then
    echo "TTS Server shutting down gracefully..."
    sleep 2
fi

# Check PID file and kill if still running
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
        echo "Stopping server (PID: $PID)..."
        kill "$PID" 2>/dev/null
        sleep 1
        # Force kill if still running
        if kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null
        fi
    fi
    rm -f "$PID_FILE"
fi

# Clean up token file
rm -f "$TOKEN_FILE"

echo "TTS Server stopped."

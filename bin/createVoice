#!/bin/bash
# Create a new custom voice clone prompt
#
# Default: saves both .pt (torch) and .wav/.txt (MLX) — requires torch env
# --mlx-only: saves only .wav/.txt — works from either env
#
# Voice creation uses the torch env by default because .pt creation requires
# the qwen-tts model. With --mlx-only, it uses whichever env matches the
# configured backend (or torch if available).

CONFIG_FILE="$HOME/Qwen3-TTS_UserFiles/config.json"

# Find and activate conda environment
if [[ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Check if --mlx-only was passed
MLX_ONLY=false
for arg in "$@"; do
    if [[ "$arg" == "--mlx-only" ]]; then
        MLX_ONLY=true
        break
    fi
done

if [[ "$MLX_ONLY" == "true" ]]; then
    # --mlx-only doesn't need torch, use the configured backend's env
    BACKEND=$(python3 -c "import json; c=json.load(open('$CONFIG_FILE')); print(c.get('advanced',{}).get('backend','torch'))" 2>/dev/null)
    if [[ "$BACKEND" == "mlx" ]]; then
        CONDA_ENV="qwen3-tts-mlx"
    else
        CONDA_ENV="qwen3-tts"
    fi
else
    # Full dual-format creation requires torch env
    CONDA_ENV="qwen3-tts"
fi

# Deactivate any current env, then activate the correct one
conda deactivate 2>/dev/null
conda activate "$CONDA_ENV"

if [[ "$CONDA_ENV" == "qwen3-tts" ]]; then
    export PYTORCH_ENABLE_MPS_FALLBACK=1
fi

python ~/Qwen3-TTS_UserFiles/create_custom_voice.py "$@"

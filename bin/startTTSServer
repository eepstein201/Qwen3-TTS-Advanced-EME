#!/bin/bash
# Start the TTS server in the background
# Reads backend from config.json and activates the correct conda environment

PID_FILE="$HOME/Qwen3-TTS_UserFiles/.voice_server.pid"
LOG_FILE="$HOME/Qwen3-TTS_UserFiles/.voice_server.log"
CONFIG_FILE="$HOME/Qwen3-TTS_UserFiles/config.json"

# Check if already running
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
        echo "TTS Server is already running (PID: $PID)"
        exit 0
    else
        rm -f "$PID_FILE"
    fi
fi

echo "Starting TTS Server..."
echo "This will load the models into memory (may take 30-60 seconds)..."

# Find and source conda
if [[ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Read backend from config.json
BACKEND="torch"
if [ -f "$CONFIG_FILE" ]; then
    BACKEND=$(python3 -c "
import json, sys
try:
    c = json.load(open('$CONFIG_FILE'))
    print(c.get('advanced', {}).get('backend', 'torch'))
except: print('torch')
" 2>/dev/null)
fi

# Select conda environment based on backend
if [ "$BACKEND" = "mlx" ]; then
    CONDA_ENV="qwen3-tts-mlx"
    echo "Backend: MLX"

    # Verify the MLX environment exists
    if ! conda env list 2>/dev/null | grep -q "^${CONDA_ENV} "; then
        echo ""
        echo "Error: MLX backend selected but environment '$CONDA_ENV' not found."
        echo "Please run './install.sh' from ~/Qwen3-TTS_UserFiles to set it up,"
        echo "or switch to the torch backend in config.json:"
        echo '  "advanced": { "backend": "torch" }'
        exit 1
    fi
else
    CONDA_ENV="qwen3-tts"
    echo "Backend: PyTorch/MPS"
fi

# Deactivate any current env, then activate the correct one
conda deactivate 2>/dev/null
conda activate "$CONDA_ENV"

# MPS fallback for unsupported ops on Apple Silicon (torch backend only)
if [ "$BACKEND" != "mlx" ]; then
    export PYTORCH_ENABLE_MPS_FALLBACK=1
fi

# Start server in background, redirect output to log
nohup python ~/Qwen3-TTS_UserFiles/voice_server.py > "$LOG_FILE" 2>&1 &

# Wait for server to be ready
echo "Waiting for server to be ready..."
for i in {1..120}; do
    if curl -s http://127.0.0.1:5123/health > /dev/null 2>&1; then
        echo "TTS Server is ready! (backend: $BACKEND)"
        echo "Use 'changeVoice' for fast generation."
        echo "Use 'stopTTSServer' to shut down."
        exit 0
    fi
    sleep 1
    # Show progress every 10 seconds
    if [ $((i % 10)) -eq 0 ]; then
        echo "  Still loading models... ($i seconds)"
    fi
done

echo "Error: Server failed to start. Check log: $LOG_FILE"
exit 1
